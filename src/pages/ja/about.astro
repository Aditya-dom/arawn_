---
import Markdown from '@components/misc/Markdown.astro'
import { getEntry } from 'astro:content'
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import I18nKey from '../../i18n/i18nKey'
import { getTranslation } from '../../i18n/translation'

const t = getTranslation('ja')
const aboutPost = await getEntry('spec', 'about-ja')

const { Content } = await aboutPost.render()
---
<MainGridLayout title={t[I18nKey.about]} description={t[I18nKey.about]} lang="ja">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
            <a href="/about/" id="view-in-english"
               class="link text-[var(--primary)] text-sm font-medium">View this page in English</a>
        </div>
    </div>
</MainGridLayout>

<script>
/* The edge middleware sends Japanese IPs here. Without a way to record an
   explicit preference, that redirect is a one-way door; the cookie is what
   the middleware checks to stand down. */
document.getElementById('view-in-english')?.addEventListener('click', () => {
    document.cookie = 'lang-pref=en; path=/; max-age=31536000; samesite=lax'
})
</script>
